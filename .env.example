# PISMA v1.3 — variáveis de ambiente (sem segredos reais)
NODE_ENV=development
APP_NAME=PISMA
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
API_PREFIX=api/v1

# PostgreSQL
DATABASE_URL=postgresql://pisma:pisma@localhost:5432/pisma

# Sessão / segurança
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=12h
BCRYPT_ROUNDS=12
PIN_BCRYPT_ROUNDS=12
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Storage (local | s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# S3/MinIO (quando STORAGE_DRIVER=s3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pisma
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Redis opcional (sessões/jobs)
REDIS_URL=
PDF_WORKER_URL=http://localhost:3001

# Observabilidade
LOG_LEVEL=info
OTEL_ENABLED=false

# CORS
CORS_ORIGINS=http://localhost:5173
